{
  "expo": {
    "name": "TaskMatrix",
    "slug": "erri-pulka",
    "owner": "erripulkas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4f46e5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projectmgmt.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "package": "com.projectmgmt.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withMonorepoFix.js"
    ],
    "extra": {
      "apiUrl": "https://project-management-api-c38i.onrender.com/api",
      "eas": {
        "projectId": "ea07fc64-bbe7-421c-8a16-19db9e54c832"
      }
    }
  }
}
